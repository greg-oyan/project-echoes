# Root-owned service environment for final-discovery-v1.
#
# Install as /etc/project-echoes/final-discovery.env, replace every OWNER_SET
# value, then run:
#   chown root:root /etc/project-echoes/final-discovery.env
#   chmod 600 /etc/project-echoes/final-discovery.env
#
# Keep this file in simple KEY=value form. Do not commit the populated file.

ECHOES_AUTHORIZE_PRODUCTION=final-discovery-v1
ECHOES_EXPECTED_SERVER_TYPE=CCX43
ECHOES_SERVER_NAME=project-echoes-final-discovery-v1

ECHOES_REPO_ROOT=/srv/project-echoes/repo
ECHOES_WORK_DIR=/srv/project-echoes/final-discovery/work
ECHOES_PREPARED_PASSAGES=/srv/project-echoes/inputs/final-discovery/passages.jsonl
# The launcher also requires the authenticated sidecar at the fixed path
# /srv/project-echoes/inputs/final-discovery/known-relationships.receipt.json.
ECHOES_KNOWNNESS_PATH=/srv/project-echoes/inputs/final-discovery/known-relationships.jsonl
ECHOES_MODEL_ROOT=/srv/project-echoes/models/intfloat-multilingual-e5-small-614241f622f5
ECHOES_UV_BIN=/usr/local/bin/uv
ECHOES_SERVICE_USER=echoes
ECHOES_SERVICE_GROUP=echoes

# Exact clean commit that the owner reviewed and transferred to the server.
ECHOES_EXPECTED_GIT_COMMIT=OWNER_SET_EXACT_GIT_COMMIT

# The canonical M7 input is frozen and may not be changed for this campaign.
ECHOES_M7_BUCKET=project-echoes-archive
ECHOES_M7_PREFIX=m7/canonical-schema-v1
ECHOES_M7_MANIFEST_SHA256=e56a1d3ee4f9707c17e7a25dc6b3d82ad5ec9a9bb28234762d58179142ebf6b6

# Choose a new, initially empty, immutable B2 destination prefix. Never reuse
# a prefix from a prior attempt or fixture.
ECHOES_OUTPUT_BUCKET=project-echoes-archive
ECHOES_OUTPUT_PREFIX=OWNER_SET_UNIQUE_EMPTY_OUTPUT_PREFIX

# Use a least-privilege Backblaze application key. These values are consumed
# from the process environment only and must never appear on a command line.
B2_APPLICATION_KEY_ID=OWNER_SET_B2_APPLICATION_KEY_ID
B2_APPLICATION_KEY=OWNER_SET_B2_APPLICATION_KEY

# Frozen service ceilings. The launcher rejects any other values.
ECHOES_FINAL_DISCOVERY_THREADS=12
ECHOES_FINAL_DISCOVERY_PROCESS_MEMORY_GIB=56
ECHOES_FINAL_DISCOVERY_DUCKDB_MEMORY_LIMIT_GIB=40
ECHOES_FINAL_DISCOVERY_INITIAL_FREE_DISK_GIB=280
ECHOES_FINAL_DISCOVERY_DISK_FLOOR_GIB=80
ECHOES_FINAL_DISCOVERY_RUNTIME_HOURS=96
ECHOES_HARD_BUDGET_USD=75.00

# Recheck the all-in hourly rate immediately before launch. Include the CCX43
# server and any separately billed Primary IPv4 in this number. The timestamp
# must be UTC and no more than 24 hours old. The B2 reserve covers storage and
# transaction/egress uncertainty; increase it if current pricing requires it.
ECHOES_VERIFIED_RATE_USD_PER_HOUR=0.529
ECHOES_RATE_VERIFIED_AT_UTC=OWNER_SET_UTC_TIMESTAMP
ECHOES_SERVER_CREATED_AT_UTC=OWNER_SET_UTC_TIMESTAMP
ECHOES_B2_COST_RESERVE_USD=10.00
