# Root-only least-privilege Scaleway poweroff guard.
#
# Install as /etc/project-echoes/scaleway-poweroff.env, replace every OWNER_SET
# value, then run:
#   chown root:root /etc/project-echoes/scaleway-poweroff.env
#   chmod 600 /etc/project-echoes/scaleway-poweroff.env
#
# The API key bearer should have only InstancesReadOnly and InstancesServerStop
# on the Project containing this Instance. The secret is shown only once when
# generated; save it before closing the Scaleway dialog.

SCW_SECRET_KEY=OWNER_SET_LEAST_PRIVILEGE_SECRET_KEY
SCW_INSTANCE_ZONE=nl-ams-1
SCW_INSTANCE_ID=OWNER_SET_INSTANCE_UUID
SCW_INSTANCE_NAME=project-echoes-final-discovery
SCW_INSTANCE_TYPE=POP2-16C-64G
