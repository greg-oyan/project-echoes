[Unit]
Description=Power off the Project Echoes Scaleway Instance after final discovery
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /srv/project-echoes/repo/cloud/scaleway_poweroff_guard.sh --poweroff
TimeoutStartSec=2min
Restart=on-failure
RestartSec=2min
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_INET AF_INET6
